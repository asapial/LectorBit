{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LectorBit",
  "version": "0.1.0",
  "identifier": "dev.lectorbit.app",
  "build": {
    "beforeDevCommand": {
      "cwd": "../../lectorbit_frontend",
      "script": "pnpm dev --host 127.0.0.1 --port 1420",
      "wait": false
    },
    "beforeBuildCommand": {
      "cwd": "../../lectorbit_frontend",
      "script": "pnpm build && node ../scripts/stage-tauri-runtime.mjs",
      "wait": true
    },
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../../lectorbit_frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "LectorBit",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset:; media-src 'self' http://127.0.0.1:*; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; frame-ancestors 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": ""
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "publisher": "LectorBit",
    "copyright": "Copyright © 2026 LectorBit contributors",
    "license": "MIT OR Apache-2.0",
    "category": "Education",
    "shortDescription": "A local-first video study planner.",
    "longDescription": "Plan, watch, transcribe, and review lectures with private local media playback and optional grounded AI study tools.",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": {
      "resources/sidecars/": "sidecars/"
    },
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "compression": "lzma",
        "startMenuFolder": "LectorBit",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  }
}
